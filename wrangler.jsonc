{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pengu-radar",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/flow-intelligence", "/health"]
  },
  "routes": [
    {
      "pattern": "api.openpengu.com",
      "custom_domain": true
    }
  ]
}
